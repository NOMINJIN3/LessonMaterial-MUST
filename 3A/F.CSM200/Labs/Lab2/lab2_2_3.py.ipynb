   "source": [
    "# lab2_2_3.py\n",
    "score = float(input(\"Тоон үнэлгээгээ оруулна уу: \"))\n",
    "\n",
    "if score > 89:\n",
    "    grade = \"A\"\n",
    "elif score > 79:\n",
    "    grade = \"B\"\n",
    "elif score > 69:\n",
    "    grade = \"C\"\n",
    "elif score > 59:\n",
    "    grade = \"D\"\n",
    "else:\n",
    "    grade = \"F\"\n",
    "\n",
    "print(f\"Үсгэн үнэлгээ: {grade}\")"
   ]
